# Copy this file to .env and adjust. Never commit .env.

# The local PostgreSQL started by `npm run db:up`. The password is for local use only.
DATABASE_URL=postgres://saas:saas@localhost:5432/saas

# Optional. The database the logic tests use. Defaults to DATABASE_URL with "_test" added.
# TEST_DATABASE_URL=postgres://saas:saas@localhost:5432/saas_test

# Optional. The port the local PostgreSQL listens on, if 5432 is taken.
# Change the port in DATABASE_URL to match.
# DB_PORT=5432

# The address the app is reached at. Used to build links in emails.
ORIGIN=http://localhost:5173

# Signs login tokens. Use a long random value and keep it secret.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# How emails are sent: "smtp" hands them to the server at SMTP_URL,
# "console" shows them in the terminal instead.
# Locally the SMTP server is Mailpit, started by `npm run db:up`. It keeps
# every email and shows it at http://localhost:8025. Nothing is really sent.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=SaaS <no-reply@localhost>

# Optional. Mailpit's ports, if 1025 or 8025 are taken.
# Change the port in SMTP_URL to match.
# MAIL_SMTP_PORT=1025
# MAIL_UI_PORT=8025

# Where uploaded files (profile pictures) are kept. "local" is the only choice
# so far: files go in the STORAGE_DIR folder on this machine.
# That is the default while developing; in production both must be set.
# STORAGE_DRIVER=local
# STORAGE_DIR=.data/uploads

# Optional. Sign-in with Google and Facebook. A provider is offered only when
# both of its values are set. In each provider's console, set the return
# address to <ORIGIN>/api/auth/callback/google or .../facebook.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# A long random value the scheduler must send to run the daily clean-up
# (permanent account deletion, expired links, old audit entries):
#   curl -X POST -H "Authorization: Bearer <value>" <ORIGIN>/api/jobs/daily
# Without it the job can't be run at all.
DAILY_JOB_SECRET=
