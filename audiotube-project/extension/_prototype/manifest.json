{
  "manifest_version": 3,
  "name": "AudioTube",
  "version": "1.0.0",
  "description": "A basic Chrome extension with a 420px side panel.",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "Open Side Panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}