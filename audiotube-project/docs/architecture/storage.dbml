// AudioTube — Stored data
// Source of truth for what the extension keeps in chrome.storage.
// View as a diagram by pasting into https://dbdiagram.io
//
// chrome.storage is a key-value store, not a database. Here each "table" is
// one storage key (or one key per tab, shown as a key pattern), and each
// "column" a field of the JSON value stored under it.
//
// Conventions:
// - Only the background service worker writes (ADR 0001).
// - Every value is checked when read; missing or invalid reads as its default or as absent.
// - Each independent value has its own key, so a write never rewrites another (GLB-013).
// - Timestamps are epoch milliseconds.
// - Text from YouTube is plain text, capped: title 300, channel 100 characters.
// - "local" survives restarts; "session" is cleared when the browser closes.

Project audiotube {
  database_type: 'chrome.storage'
  Note: 'Stored state of the AudioTube Chrome extension'
}

// ---------- Settings (local) — built ----------

Table setting_audio_only {
  audioOnly boolean [not null, default: true, note: 'Key: audioOnly. PLY-001 to PLY-003']
  Note: 'chrome.storage.local'
}

Table setting_save_bandwidth {
  saveBandwidth boolean [not null, default: true, note: 'Key: saveBandwidth. PLY-008. No switch until Settings (section 7)']
  Note: 'chrome.storage.local'
}

// ---------- Overlay status (session) — built ----------

Table overlay_status {
  tab_id integer [pk, note: 'Part of the key: overlayStatus:<tabId>']
  status varchar [not null, note: 'Only "failed" is stored; ok removes the key. PLY-021']
  Note: 'chrome.storage.session. Removed when the tab closes or loads a new page'
}

// ---------- Now Playing and the playback tab — built in phase 3 ----------

Table now_playing {
  videoId varchar(11) [not null, note: 'Key: nowPlaying. Absent means idle']
  title varchar(300) [not null]
  channel varchar(100) [not null]
  durationSec integer [note: 'Null for live streams and upcoming premieres']
  isLive boolean [not null, default: false]
  positionSec integer [not null, default: 0, note: 'Saved every 5 s while playing, and on pause and tab loss. PLY-130']
  positionSavedAt bigint [not null, note: 'epoch ms']
  updatedAt bigint [not null, note: 'epoch ms; when the video last changed']
  Note: 'chrome.storage.local. Carries its own copy of the video details until the Queue phase decides on shared video records'
}

Table playback_tab {
  tabId integer [not null, note: 'Key: playbackTab. Absent means no playback tab (GLB-001)']
  windowId integer [not null]
  state varchar [not null, note: 'playing, paused, buffering or ended']
  stateAt bigint [not null, note: 'epoch ms']
  positionSec decimal [note: 'Phase 4, ADR 0007: the position at stateAt']
  rate decimal [default: 1, note: 'Phase 4, ADR 0007: playback rate at stateAt']
  Note: 'chrome.storage.session, so a browser restart clears it (PLY-054). From phase 4 the state, position, rate and stateAt are written together, as one snapshot the side panel counts forward from'
}

// ---------- Volume (local) — Phase 4 ----------

Table volume {
  level integer [not null, note: 'Key: volume. 0 to 100. Absent until the first playback tab reports its volume or the user sets it. PLY-061 to PLY-063']
  muted boolean [not null, default: false]
  Note: 'chrome.storage.local. Applied to a tab when it becomes the playback tab; updated when the playback tab or the side panel changes it'
}

Table pending_resume {
  tabId integer [not null, note: 'Key: resume. Set when Resume opens a tab; removed when that tab plays or is lost']
  startedAt bigint [not null, note: 'epoch ms. The panel says "waiting" if the tab has not started after 10 s']
  Note: 'chrome.storage.session'
}

Table tab_video {
  tab_id integer [pk, note: 'Part of the key: tabVideo:<tabId>']
  videoId varchar(11) [not null]
  title varchar [not null, note: 'As reported by the page; capped when copied into now_playing']
  channel varchar [not null]
  durationSec integer
  isLive boolean [not null]
  Note: 'chrome.storage.session. The last video a tab reported, so its details are there when it starts playing. Removed when the tab closes or is replaced'
}

// ---------- Outside chrome.storage — built ----------

Table page_previous_quality {
  value varchar [not null, note: 'Key: audiotube.previousQuality in YouTube\'s own localStorage. A level name such as hd720, or auto']
  Note: 'Written and read only by the page script, so the user\'s quality can be put back after a reload. Removed when audio-only turns off'
}

TableGroup settings {
  setting_audio_only
  setting_save_bandwidth
  volume
}

TableGroup playback {
  now_playing
  playback_tab
  pending_resume
  tab_video
  overlay_status
}
